# deploy/k8s/deploy.sh's settings: copy to deploy/k8s/kube.env (or name
# another file with KUBE_ENV=...) and fill in. kubectl's current context is
# the cluster it deploys to. K8S.md#deploying says what a deploy does.

# The project's image, without its tag: deploy.sh <tag> deploys MORCA_IMAGE:<tag>.
MORCA_IMAGE=ghcr.io/morca-dev/census

# Required: how long, in seconds, an old scheduler may keep draining its
# runs after a deploy before it kills them (MORCA_DRAIN_SECONDS;
# docs/hetzner.md#the-drain-limit).
DRAIN_SECONDS=604800

# Required once a pipeline declares a concurrency key: how long, in
# seconds, a run waiting on the key may wait for a run of an older version
# to end before it fails (MORCA_HANDOVER_WAIT_SECONDS;
# docs/hetzner.md#the-handover-wait-limit). The census's mojo_live has one.
HANDOVER_WAIT_SECONDS=3600

# Overlapping schedulers (MORCA_OVERLAP, docs/overlap.md): 0 turns it off,
# and every deploy that replaces the scheduler then pauses and waits.
#OVERLAP=1

# The manifests applied, their image morca:dev as MORCA_IMAGE:<tag>. By
# default deploy/k8s's morca.yaml, runs.yaml, postgres-backup.yaml and
# ui.yaml; name your own copies here (local-secrets.yaml is for kind only).
#MANIFESTS="deploy/k8s/morca.yaml deploy/k8s/runs.yaml deploy/k8s/postgres-backup.yaml deploy/k8s/ui.yaml"

# More of the scheduler's environment, KEY=VALUE separated by spaces (no
# spaces in a value), through the ConfigMap morca-settings; morca.yaml's own
# env wins over them.
#EXTRA_ENV="MORCA_VCPU_BUDGET=16 MORCA_RUN_DEADLINE=43200"

# Canary runs the check ends with, PIPELINE=KEY separated by spaces, each
# of which must succeed within CANARY_TIMEOUT seconds (1800). Real runs: for
# a beta stack, not production.
#CANARY="toy=2024-01"
#CANARY_TIMEOUT=1800

# How long the Deployments may take to roll out, and pods of the new image
# to finish (300 s).
#HEALTH_TIMEOUT=300

# The Secret the cluster pulls a private image with, for deploy.sh's own
# pods of the image and the apps (the scheduler's run pods take
# MORCA_KUBE_PULL_SECRET).
#PULL_SECRET=ghcr
